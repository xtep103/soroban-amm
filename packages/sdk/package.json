{
  "name": "@soroban-amm/sdk",
  "version": "0.1.0",
  "description": "TypeScript/JavaScript SDK for the Soroban AMM contract",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json",
    "generate:abi": "node scripts/generate-abi-fixture.mjs && node scripts/generate-contract-types.mjs",
    "check:abi": "node scripts/generate-abi-fixture.mjs --check && node scripts/generate-contract-types.mjs --check",
    "lint": "eslint ."
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3"
  }
}
